<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- simple vehicle type -->
    <vType id="car" length="4.50" minGap="2.50" maxSpeed="13.90" emissionClass="HBEFA3/PC_G_EU6" guiShape="passenger" color="red" accel="2.6" decel="4.5" sigma="0.5"/>
    <vType id="bus" length="13.50" minGap="2.50" maxSpeed="8.00" emissionClass="HBEFA3/PC_G_EU6" guiShape="bus" color="blue" accel="2.0" decel="4.5" sigma="0.5"/>

    <!-- Flow 1: A2A3 -> E2D2, one vehicle every 6 seconds -->
    <route id="r_upper" edges="A2A3 A3B3 B3C3 C3C2 C2D2 D2E2"/>
    <flow id="flow_0" type="car" begin="0" end="3600" period="6.0" route="r_upper"/>

    <!-- Flow 2: A2A1 -> D2E2, one bus every 12 seconds -->

    <route id="bus" edges="A2A1 A1B1 B1C1 C1C2 C2D2 D2E2"/>
    <flow id="flow_1" type="bus" begin="0" end="3600" period="12.0" route="bus">
        <stop busStop="bs_0" duration="15"/>
        <stop busStop="bs_1" duration="15"/>
        <stop busStop="bs_2" duration="15"/>
    </flow>
</routes>
